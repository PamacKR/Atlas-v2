{
  "name": "atlas",
  "version": "0.1.0",
  "description": "Atlas — a centralized academic knowledge platform",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -b && tsc --noEmit -p tsconfig.renderer.json && node scripts/build-renderer.js && node scripts/copy-assets.js",
    "start": "npm run build && electron .",
    "start:fast": "electron .",
    "watch": "tsc -b -w",
    "verify": "npm run build && node scripts/verify-app.js",
    "mcp:server": "node scripts/run-mcp-server.js",
    "verify:mcp": "npm run build && node scripts/run-as-electron-node.js scripts/verify-mcp.js",
    "verify:extraction": "npm run build && node scripts/run-as-electron-node.js scripts/verify-extraction.js",
    "verify:remote": "npm run build && node scripts/run-as-electron-node.js scripts/verify-remote.js",
    "package:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.atlas.desktop",
    "productName": "Atlas",
    "directories": {
      "output": "release"
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.11",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.28.1",
    "playwright": "^1.61.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@milkdown/crepe": "^7.21.3",
    "@milkdown/kit": "^7.21.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "^1.0.2",
    "adm-zip": "^0.6.0",
    "better-sqlite3": "^11.7.0",
    "chokidar": "^4.0.3",
    "googleapis": "^173.0.0",
    "katex": "^0.18.1",
    "mammoth": "^1.12.0",
    "marked": "^12.0.2",
    "pdfjs-dist": "^6.1.200",
    "tesseract.js": "^7.0.0",
    "xlsx": "^0.18.5"
  }
}
